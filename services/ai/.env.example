# Python AI service (services/ai) environment.
# Copy to services/ai/.env. This service reads only this file (plus process env).
#
# NOTE: For the Docker full-stack (`docker compose up`), these values are
# injected by docker-compose.yml (postgres/redis resolve to service names,
# FILE_STORAGE_DIR -> shared volume, INTERNAL_API_TOKEN shared with web). This
# file is for non-container local runs.

# POSTGRES_* are the single source of truth; the connection string is
# derived from them in app/config.py.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledgeops
POSTGRES_USER=knowledgeops
POSTGRES_PASSWORD=knowledgeops

# Optional override (e.g. managed database in production):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (required; supports standalone, Sentinel, or managed cloud via URL).
REDIS_URL=redis://localhost:6379

EMBEDDING_DIMENSIONS=1536
WORKER_POLL_INTERVAL=2.0

# AI provider (embeddings): "fake" (default) keeps embeddings offline +
# deterministic for local dev and tests; "openrouter" uses the real API
# (requires OPENROUTER_API_KEY). qwen3-embedding-8b is native 4096 dims with
# MRL: vectors are truncated to EMBEDDING_DIMENSIONS + L2-normalized.
AI_PROVIDER=fake
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=60.0
EMBEDDING_MAX_RETRIES=4

# OpenRouter (OpenAI-compatible). Used only when AI_PROVIDER=openrouter.
# Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Shared local directory for uploaded source files. The web layer writes files
# here and records the relative path in documents.source_metadata.storage_path.
FILE_STORAGE_DIR=./data/uploads

# Chunking defaults (characters). Tunable for evaluation in Phase 7.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Shared secret for internal Web -> AI calls (X-Internal-Token header). Must
# match apps/web INTERNAL_API_TOKEN. Leave empty only for local/offline tests.
INTERNAL_API_TOKEN=

# Retrieval default top-k for /v1/retrieve (tunable for Phase 7 evaluation).
RETRIEVAL_TOP_K=5

# Batch evaluation (T7.3): optional LLM-as-judge for correctness/groundedness.
# Off by default so evaluation runs fully offline and deterministically in fake
# mode; "true" refines metrics using the configured LLM provider.
EVALUATION_USE_LLM_JUDGE=false

# LLM provider, independent from AI_PROVIDER (embeddings). "fake" (default) is
# deterministic + offline for tests; "deepseek" calls the real DeepSeek API.
LLM_PROVIDER=fake

# Minimum cosine similarity for the assistant to answer; below this it refuses.
ANSWER_MIN_SCORE=0.2

# DeepSeek (OpenAI-compatible). Used only when LLM_PROVIDER=deepseek.
# Never commit a real key. Embeddings stay on FakeEmbeddings (DeepSeek has no
# embedding API and the schema is fixed at 1536 dims).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Real LLM call tuning (deepseek provider).
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
