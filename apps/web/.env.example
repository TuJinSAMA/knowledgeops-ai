# Next.js web app (apps/web) environment.
# Copy to apps/web/.env. This service reads only this file (plus process env).
# Keep this file in sync with src/env.ts (every variable validated there must
# appear here).
#
# NOTE: For the Docker full-stack (`docker compose up`), these values are
# injected by docker-compose.yml (postgres/redis/ai resolve to service names,
# FILE_STORAGE_DIR -> shared volume). This file is for non-container local runs.

# --- Database -------------------------------------------------------------
# POSTGRES_* are the single source of truth; DATABASE_URL is derived from them
# in src/env.ts. Set DATABASE_URL explicitly to override (e.g. managed DB).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledgeops
POSTGRES_USER=knowledgeops
POSTGRES_PASSWORD=knowledgeops

# Optional override (takes precedence over POSTGRES_* when set):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Redis ----------------------------------------------------------------
# Required dependency. Supports standalone, Sentinel, or managed cloud via URL.
REDIS_URL=redis://localhost:6379

# --- Auth (better-auth) ---------------------------------------------------
# Generate a strong secret in production, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-insecure-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# Public base URL of the web app (exposed to the browser by the auth client).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI service (Web -> AI internal calls; used from Phase 4) -------------
# Base URL of the Python FastAPI AI service (chat calls POST /v1/answer here).
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret sent as the X-Internal-Token header on every Web -> AI call.
# It MUST be identical to INTERNAL_API_TOKEN in services/ai/.env or the AI
# service returns 401 and chat/retrieval will not work. Leave both sides empty
# only for local/offline development (the AI service then skips the check).
INTERNAL_API_TOKEN=

# --- Rate limiting (per-IP fixed window, per minute) ----------------------
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=20

# --- Per-workspace token quotas (0 disables the limit) --------------------
QUOTA_DAILY_TOKENS=200000
QUOTA_MONTHLY_TOKENS=5000000

# --- File storage (uploaded source documents) ----------------------------
# Root directory for stored source files. The Python ingestion worker reads
# the same files by joining this root with documents.source_metadata.storage_path,
# so web and worker must resolve to the SAME directory. When they run from
# different working directories, set an absolute path here (and in services/ai).
FILE_STORAGE_DIR=./data/uploads

# Maximum accepted upload size in bytes (default 20 MiB).
MAX_UPLOAD_BYTES=20971520
